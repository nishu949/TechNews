APP_NAME=TechNews
APP_ENV=production
APP_DEBUG=false
APP_URL=https://technews-ycl9.onrender.com

DB_CONNECTION=pgsql
DATABASE_URL=postgresql://technews_user:password@dpg-xxxxxx:5432/technews
PGSSLMODE=require

SESSION_DRIVER=file
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
FILESYSTEM_DISK=local

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_LEVEL=error